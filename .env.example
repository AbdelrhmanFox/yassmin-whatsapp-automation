# ── Supabase (قاعدة البيانات — مفضّل) ──
# من Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# على Vercel: يفضّل إضافته لتفعيل الفورم + رفع الإيصالات بدون Edge
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=yassmin
# بدون service_role على Vercel: استخدم Edge Function
SUPABASE_PAYMENTS_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/yassmin-payments-api
SUPABASE_DASHBOARD_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/yassmin-dashboard-api
SUPABASE_ANON_KEY=
# supabase | sheets (افتراضي: supabase إذا المفاتيح موجودة)
DATABASE_PROVIDER=supabase

# ── Google Sheets (احتياطي / ترحيل) ──
# ملف البوت: https://docs.google.com/spreadsheets/d/1frBgjb61hrUrWdErjgK74wkStcF6nx2-uNfIb6ILlnY
BOT_SPREADSHEET_ID=1frBgjb61hrUrWdErjgK74wkStcF6nx2-uNfIb6ILlnY

# ملف الدفع: https://docs.google.com/spreadsheets/d/1DoDcs3QnwDmkNim8OKQ7wm3I8JJoQiwhIcHamHo6a8w
PAYMENT_SPREADSHEET_ID=1DoDcs3QnwDmkNim8OKQ7wm3I8JJoQiwhIcHamHo6a8w
PAYMENT_SHEET_NAME=عمليات الدفع
PAYMENT_MATCH_COLUMN=طابع زمني

# Vercel / Production: Service Account JSON (سطر واحد — من Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_JSON=

# بديل محلي: OAuth (بعد npm run sync:google-sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── لوحة التحكم ──
DASHBOARD_ADMIN_TOKEN=
# true = اللوحة بدون توكن (افتراضي)
DASHBOARD_DISABLE_AUTH=true
# نموذج الدفع العام على /form.html
PUBLIC_FORM_ENABLED=true

# ── n8n (اختياري) ──
CONTROL_WEBHOOK_URL=
N8N_WEBHOOK_URL=
