# ── Supabase (قاعدة البيانات — مفضّل) ──
# من Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# مطلوب على Vercel لـ: الفورم العام، تبويب «ردود البوت» (CRUD على yassmin.keywords)، وغيرها عبر payments-store
# من Supabase → Project Settings → API → service_role (سري — لا تضعيه في المتصفح أو Git)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=yassmin
# بدون service_role على Vercel: استخدم Edge Function
SUPABASE_PAYMENTS_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/yassmin-payments-api
SUPABASE_DASHBOARD_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/yassmin-dashboard-api
SUPABASE_ANON_KEY=
# بدون service_role صحيح: يُستدعى yassmin-dashboard-api لردود البوت (GET/POST/PATCH/DELETE /keywords) لتجاوز RLS على yassmin.keywords.
# إن كان true: عمليات الدفع من Vercel تمر عبر PostgREST مباشرة وليس عبر Edge (نادر — إذا أردت service_role حقيقي رغم وجود دالة الدفع)
# SUPABASE_PAYMENTS_USE_DIRECT_DB=false
# supabase | sheets (افتراضي: supabase إذا المفاتيح موجودة)
DATABASE_PROVIDER=supabase

# ── Google Sheets (احتياطي / ترحيل) ──
# ملف البوت: https://docs.google.com/spreadsheets/d/1frBgjb61hrUrWdErjgK74wkStcF6nx2-uNfIb6ILlnY
BOT_SPREADSHEET_ID=1frBgjb61hrUrWdErjgK74wkStcF6nx2-uNfIb6ILlnY

# ملف الدفع: https://docs.google.com/spreadsheets/d/1DoDcs3QnwDmkNim8OKQ7wm3I8JJoQiwhIcHamHo6a8w
PAYMENT_SPREADSHEET_ID=1DoDcs3QnwDmkNim8OKQ7wm3I8JJoQiwhIcHamHo6a8w
PAYMENT_SHEET_NAME=عمليات الدفع
PAYMENT_MATCH_COLUMN=طابع زمني

# Vercel / Production: Service Account JSON (سطر واحد — من Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_JSON=

# بديل محلي: OAuth (بعد npm run sync:google-sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── لوحة التحكم ──
DASHBOARD_ADMIN_TOKEN=
# true = اللوحة بدون توكن (افتراضي)
DASHBOARD_DISABLE_AUTH=true
# نموذج الدفع العام على /form.html
PUBLIC_FORM_ENABLED=true

# ── Evolution (زر «إرسال الآن» — مباشرة من Vercel بدون n8n) ──
EVOLUTION_API_URL=https://evolution.growleadpro.com
EVOLUTION_INSTANCE=Yas
EVOLUTION_API_KEY=

# ── n8n — كرون إرسال تأكيد الدفع من Supabase (كل 30 د) ──
# انقل القيم لمتغيرات البيئة في خادم n8n عند استيراد payment-auto-send-cron-supabase-n8n-workflow.json
YASSMIN_SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT.supabase.co/functions/v1

# ── n8n (البوت + كرون الدفع — اختياري لـ «إرسال الآن») ──
CONTROL_WEBHOOK_URL=
N8N_WEBHOOK_URL=https://n8n.growleadpro.com/webhook/whatsapp
# لم يعد مطلوباً لزر «إرسال الآن» (يُرسل من Vercel). للكرون/تجارب قديمة فقط:
N8N_PAYMENT_SEND_WEBHOOK_URL=https://n8n.growleadpro.com/webhook/yassmin-send-payment
N8N_WEBHOOK_SECRET=
