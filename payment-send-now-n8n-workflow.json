      "id": "a1000004-0004-4004-8004-000000000004",
      "name": "HTTP: Read Paused Chats (Payment DB)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-960, 520],
      "alwaysOutputData": true
