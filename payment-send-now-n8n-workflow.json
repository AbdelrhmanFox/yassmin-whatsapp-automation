      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst prep = $('Code: Prepare Single Payment Send').first().json;\nconst messageId =\n  resp?.key?.id ||\n  resp?.message?.key?.id ||\n  resp?.data?.key?.id ||\n  resp?.messages?.[0]?.key?.id ||\n  '';\nconst base = {\n  form_timestamp: prep.form_timestamp,\n  phone: prep.phone,\n  confirmation_text: prep.confirmation_text,\n  processed_at: prep.processed_at\n};\nif (!messageId) {\n  const errMsg =\n    resp?.error?.message ||\n    resp?.message ||\n    (resp?.error ? String(resp.error) : '') ||\n    'no_outbound_message_id';\n  return [{ json: { ...base, send_ok: false, send_error: errMsg, evolution_response: resp } }];\n}\nreturn [{ json: { ...base, send_ok: true, message_id: messageId, send_error: '' } }];"
