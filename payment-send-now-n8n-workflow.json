    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const wh = $('Webhook: Send Payment Now').first().json;\nconst body = wh.body || wh;\nconst secret = String($env.N8N_WEBHOOK_SECRET || '').trim();\nif (secret) {\n  const got = String(wh.headers?.['x-n8n-secret'] || wh.headers?.['X-N8n-Secret'] || '').trim();\n  if (got !== secret) {\n    return [{ json: { ok: false, should_send: false, precheck_error: 'unauthorized', form_timestamp: '' } }];\n  }\n}\n\nconst targetTs = String(body.form_timestamp || '').trim();\nif (!targetTs) {\n  return [{ json: { ok: false, should_send: false, precheck_error: 'missing_form_timestamp', form_timestamp: '' } }];\n}\n\nconst payResp = $('HTTP: Read Payments (DB)').first().json || {};\nconst prodResp = $('HTTP: Read Products (DB)').first().json || {};\nconst pausedResp = $('HTTP: Read Paused Chats (Payment DB)').first().json || {};\n\nconst allRows = Array.isArray(payResp.rows) ? payResp.rows : [];\nconst r = allRows.find((row) => String(row.timestamp || row.id || '').trim() === targetTs);\nif (!r) {\n  return [{ json: { ok: false, should_send: false, precheck_error: 'payment_not_found', form_timestamp: targetTs } }];\n}\n\nconst FIXED_CONFIRMATION = 'تم تأكيد الدفع.';\nconst pdfByCode = {};\nfor (const p of prodResp.products || []) {\n  const c = String(p.product_code || '').trim().toLowerCase();\n  const u = String(p.pdf_url || '').trim();\n  if (c && u) pdfByCode[c] = u;\n}\n\nfunction normalizePhone(v) {\n  let d = String(v ?? '').replace(/\\D/g, '');\n  if (!d) return '';\n  if (d.startsWith('20') && d.length === 12) return d;\n  if (d.startsWith('0') && d.length === 11) return '20' + d.slice(1);\n  if (!d.startsWith('20') && d.length === 10) return '20' + d;\n  return d;\n}\n\nfunction isPhonePaused(phone) {\n  const rows = Array.isArray(pausedResp.rows) ? pausedResp.rows : [];\n  const p = normalizePhone(phone);\n  const now = Date.now();\n  for (const row of rows) {\n    if (normalizePhone(row.phone) !== p) continue;\n    if (row.active === false) continue;\n    const exp = new Date(row.expires_at).getTime();\n    if (Number.isFinite(exp) && exp > now) return true;\n  }\n  return false;\n}\n\nconst done = Boolean(r.done);\nconst status = String(r.whatsapp_status || '').trim().toLowerCase();\nconst phone = normalizePhone(r.phone);\nlet precheckError = '';\n\nif (!done) precheckError = 'payment_not_confirmed';\nelse if (status === 'sent') precheckError = 'already_sent';\nelse if (status === 'dead_letter') precheckError = 'dead_letter';\nelse if (!phone) precheckError = 'missing_phone';\nelse if (!/^20\\d{10}$/.test(phone)) precheckError = 'invalid_phone';\nelse if (isPhonePaused(phone)) precheckError = 'human_handoff_paused';\n\nconst productCodeNorm = String(r.product_code || '').trim().toLowerCase();\nconst pdfUrl = productCodeNorm ? (pdfByCode[productCodeNorm] || '') : '';\nconst confirmation_text = pdfUrl\n  ? FIXED_CONFIRMATION + '\\n\\nرابط تحميل الكتاب (PDF):\\n' + pdfUrl\n  : FIXED_CONFIRMATION + '\\n\\nلم يُعثر على رابط PDF لهذا الكتاب؛ سنتواصل معك لاحقًا.';\n\nconst processed_at = new Date().toISOString();\nconst should_send = precheckError === '';\n\nreturn [{\n  json: {\n    ok: true,\n    form_timestamp: targetTs,\n    phone,\n    confirmation_text,\n    pdf_url: pdfUrl,\n    product_code: r.product_code,\n    should_send,\n    precheck_error: precheckError,\n    processed_at,\n    stage: should_send ? 'ready_to_send' : 'precheck_failed'\n  }\n}];"
      },
